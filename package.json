{
  "name": "echo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:engine": "esbuild src/engine/index.ts --bundle --format=esm --target=es2022 --outfile=supabase/functions/submit-run/engine.js",
    "test:determinism": "esbuild scripts/determinism.ts --bundle --platform=node --outfile=node_modules/.cache/determinism.cjs --log-level=warning && node node_modules/.cache/determinism.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
